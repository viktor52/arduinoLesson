# Database (Supabase)
# DATABASE_URL = Transaction pooler (port 6543), add ?pgbouncer=true
# DIRECT_URL  = Direct connection (port 5432) for migrations
DATABASE_URL="postgresql://arduino:arduino123@localhost:5432/arduino_learning?schema=public"
DIRECT_URL="postgresql://arduino:arduino123@localhost:5432/arduino_learning?schema=public"

# Server
PORT=3001
NODE_ENV=development
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
# Comma-separated allowed origins; *.vercel.app is also allowed automatically
CLIENT_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Frontend (optional) — leave unset on Vercel so the app uses same-origin /api
# VITE_API_URL=http://localhost:3001/api
