PORT=3001
NODE_ENV=development
# Supabase/Vercel injects POSTGRES_PRISMA_URL and POSTGRES_URL_NON_POOLING.
# DATABASE_URL remains available for local development.
POSTGRES_PRISMA_URL="postgresql://..."
POSTGRES_URL_NON_POOLING="postgresql://..."
DATABASE_URL="postgresql://arduino:arduino123@localhost:5432/arduino_learning?schema=public"
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
