{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npx prisma generate && npm run build --workspace=shared && npm run build --workspace=server && npm run build --workspace=client",
  "outputDirectory": "client/dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "{prisma/**,node_modules/.prisma/**,node_modules/@prisma/client/**,server/dist/**,shared/dist/**}"
    }
  }
}
